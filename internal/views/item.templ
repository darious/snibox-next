package views

import (
    "html/template"
    "github.com/darious1472/snibox-next/internal/markdown"
    "github.com/darious1472/snibox-next/internal/store"
)

templ Item(it *store.Item, readOnly bool) {
    <div class="main-head">
        if readOnly {
            <span class="title">{ it.Title }</span>
        } else {
            <input class="title"
                   type="text"
                   name="title"
                   value={ it.Title }
                   hx-patch={ "/items/" + it.ID }
                   hx-trigger="change, keydown[key=='Enter']"
                   hx-swap="none"/>
        }
        if !readOnly {
            <button id="pin-btn" class={ pinBtnClass(it.Pinned) } title="Pin (p)"
                    hx-post={ "/items/" + it.ID + "/pin" }
                    hx-target="closest button"
                    hx-swap="outerHTML">
                @templ.Raw(IconPin)
            </button>
            <button class="icon-btn" title="Archive"
                    hx-post={ "/items/" + it.ID + "/archive" }
                    hx-swap="none">
                @templ.Raw(IconArchive)
            </button>
            <button class="icon-btn danger" title="Delete"
                    hx-delete={ "/items/" + it.ID }
                    hx-confirm="Delete this item?"
                    hx-target="#main"
                    hx-swap="innerHTML">
                @templ.Raw(IconTrash)
            </button>
        }
    </div>
    <div class="meta-bar">
        if it.Type == store.TypeSnippet {
            <label>
                lang
                <select name="language"
                        hx-post={ "/items/" + it.ID + "/body" }
                        hx-include={ "#snippet-textarea-" + it.ID + ", this" }
                        hx-trigger="change"
                        hx-target={ "#preview-" + it.ID }
                        hx-swap="innerHTML"
                        disabled?={ readOnly }>
                    for _, l := range CommonLanguages {
                        <option value={ l } selected?={ DerefStr(it.Language) == l }>{ l }</option>
                    }
                </select>
            </label>
        }
        for _, t := range it.Tags {
            <span class="tag-chip">
                { "#" + t }
                if !readOnly {
                    &nbsp;
                    <a href="#" style="color:inherit"
                       hx-delete={ "/items/" + it.ID + "/tags/" + t }
                       hx-target="#main"
                       hx-swap="innerHTML">×</a>
                }
            </span>
        }
        if !readOnly {
            <form hx-post={ "/items/" + it.ID + "/tags" }
                  hx-target="#main"
                  hx-swap="innerHTML">
                <input class="tag-add" type="text" name="tag" placeholder="+ tag"
                       size="10" autocomplete="off"/>
            </form>
        }
    </div>
    <div class="main-body">
        if it.Type == store.TypeSnippet {
            @snippetBody(it, readOnly)
        } else if it.Type == store.TypeNote {
            @noteBody(it, readOnly)
        } else if it.Type == store.TypeLink {
            @linkBody(it, readOnly)
        }
    </div>
}

func pinBtnClass(p bool) string {
    if p {
        return "icon-btn active"
    }
    return "icon-btn"
}

templ snippetBody(it *store.Item, readOnly bool) {
    if readOnly {
        <div class="snippet-toolbar">
            <button class="btn" data-copy-target={ "preview-" + it.ID }>Copy</button>
        </div>
        <div id={ "preview-" + it.ID } class="snippet-block">
            @templ.Raw(highlight(it.Body, DerefStr(it.Language)))
        </div>
    } else {
        <div class="snippet-toolbar">
            <button class="btn" data-copy-target={ "preview-" + it.ID }>Copy</button>
            <span class="autosave" id="autosave-status">saved</span>
        </div>
        <div class="snippet-split">
            <textarea name="body"
                      id={ "snippet-textarea-" + it.ID }
                      spellcheck="false"
                      hx-post={ "/items/" + it.ID + "/body" }
                      hx-trigger="keyup changed delay:200ms, change"
                      hx-target={ "#preview-" + it.ID }
                      hx-swap="innerHTML"
                      data-autosave="true">{ it.Body }</textarea>
            <div id={ "preview-" + it.ID } class="snippet-block live-preview">
                @templ.Raw(highlight(it.Body, DerefStr(it.Language)))
            </div>
        </div>
    }
}

templ noteBody(it *store.Item, readOnly bool) {
    if readOnly {
        <div class="rendered" style="max-width:none">
            @templ.Raw(render(it.Body))
        </div>
    } else {
        <div class="snippet-toolbar" style="margin-bottom:8px">
            <span class="autosave" id="autosave-status">saved</span>
        </div>
        <div class="note-grid">
            <textarea name="body"
                      spellcheck="false"
                      placeholder="Write markdown…"
                      hx-post={ "/items/" + it.ID + "/body" }
                      hx-trigger="keyup changed delay:250ms, change"
                      hx-target={ "#preview-" + it.ID }
                      hx-swap="innerHTML"
                      data-autosave="true">{ it.Body }</textarea>
            <div id={ "preview-" + it.ID } class="rendered live-preview">
                @templ.Raw(render(it.Body))
            </div>
        </div>
    }
}

templ linkBody(it *store.Item, readOnly bool) {
    <div class="link-card">
        <div class="url-row">
            if readOnly {
                <span style="flex:1; font-family: var(--font-mono); font-size:13px">{ DerefStr(it.URL) }</span>
            } else {
                <input type="url" name="url" value={ DerefStr(it.URL) }
                       hx-patch={ "/items/" + it.ID }
                       hx-trigger="change"
                       hx-swap="none"/>
            }
            <a class="btn primary" href={ templ.SafeURL(DerefStr(it.URL)) } target="_blank" rel="noopener noreferrer">Open</a>
        </div>
        if readOnly {
            <div class="rendered">@templ.Raw(render(it.Body))</div>
        } else {
            <div class="note-grid">
                <textarea name="body" placeholder="Description (markdown)"
                          hx-post={ "/items/" + it.ID + "/body" }
                          hx-trigger="keyup changed delay:250ms, change"
                          hx-target={ "#preview-" + it.ID }
                          hx-swap="innerHTML"
                          hx-on::before-request="document.getElementById('autosave-status').textContent='saving…'"
                          hx-on::after-request="document.getElementById('autosave-status').textContent='saved'">{ it.Body }</textarea>
                <div id={ "preview-" + it.ID } class="rendered live-preview">
                    @templ.Raw(render(it.Body))
                </div>
            </div>
            <span class="autosave" id="autosave-status">saved</span>
        }
    </div>
}

func render(body string) template.HTML {
    h, err := markdown.RenderMarkdown(body)
    if err != nil {
        return template.HTML("<pre>" + body + "</pre>")
    }
    return h
}

func highlight(body, lang string) template.HTML {
    h, err := markdown.HighlightCode(body, lang)
    if err != nil {
        return template.HTML("<pre>" + body + "</pre>")
    }
    return h
}
