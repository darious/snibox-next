package views

templ NewModal() {
    <div class="modal-backdrop" onclick="if(event.target===this) document.getElementById('modal-host').innerHTML=''">
        <div class="modal">
            <div class="modal-head">New item</div>
            <form hx-post="/items"
                  hx-target="#main"
                  hx-swap="innerHTML"
                  hx-on::after-request="document.getElementById('modal-host').innerHTML=''">
                <div class="modal-body">
                    <label>
                        Title
                        <input type="text" name="title" required autofocus maxlength="200"/>
                    </label>
                    <label>
                        Type
                        <select name="type" id="new-type"
                                onchange="document.getElementById('new-lang').hidden = this.value !== 'snippet'; document.getElementById('new-url').hidden = this.value !== 'link';">
                            <option value="snippet">Snippet</option>
                            <option value="note">Note</option>
                            <option value="link">Link</option>
                        </select>
                    </label>
                    <label id="new-lang">
                        Language
                        <select name="language">
                            for _, l := range CommonLanguages {
                                <option value={ l }>{ l }</option>
                            }
                        </select>
                    </label>
                    <label id="new-url" hidden>
                        URL
                        <input type="url" name="url" placeholder="https://…"/>
                    </label>
                    <label>
                        Tags (space separated)
                        <input type="text" name="tags" placeholder="docker homelab"/>
                    </label>
                    <label>
                        Body
                        <textarea name="body"></textarea>
                    </label>
                </div>
                <div class="modal-foot">
                    <button type="button" class="btn"
                            onclick="document.getElementById('modal-host').innerHTML=''">Cancel</button>
                    <button type="submit" class="btn primary">Create</button>
                </div>
            </form>
        </div>
    </div>
}
