package views

import "github.com/darious1472/snibox-next/internal/store"

type PageData struct {
    View       string
    Tag        string   // when scoped by /tag/{tag}
    Query      string
    Counts     store.Counts
    TagCounts  []store.TagCount
    Items      []*store.Item
    NextCursor string
    Active     *store.Item    // optional initial item to show in main pane
    Draft      *store.ItemType // when set, render NewEditor in main
    ReadOnly   bool
}

templ Page(d PageData) {
    <!DOCTYPE html>
    <html lang="en">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <title>Snibox Next</title>
            <link rel="icon" type="image/svg+xml" href="/static/img/favicon.svg"/>
            <link rel="stylesheet" href="/static/css/theme.css"/>
            <link rel="stylesheet" href="/static/css/chroma.css"/>
            <script src="/static/js/htmx.min.js" defer></script>
            <script src="/static/js/app.js" defer></script>
        </head>
        <body>
            <div class="app">
                @navRail(d)
                <section class="list-pane" id="list-pane">
                    @ListPane(d)
                </section>
                <section class="main-pane" id="main">
                    if d.Draft != nil {
                        @NewEditor(*d.Draft)
                    } else if d.Active != nil {
                        @Item(d.Active, d.ReadOnly)
                    } else {
                        <div class="main-empty">Select an item, or press <span class="kbd">n</span> to create one.</div>
                    }
                </section>
            </div>
            <div id="toasts"></div>
        </body>
    </html>
}

templ navRail(d PageData) {
    <nav class="rail">
        <div class="rail-head">
            <span class="brand-mark">
                <img src="/static/img/logo.svg" alt="" width="26" height="26"/>
            </span>
            <span>Snibox</span>
        </div>
        if !d.ReadOnly {
            <div class="rail-cta">
                <a href="/new?type=snippet" class="btn primary block">
                    @templ.Raw(IconPlus)
                    <span>Add snippet</span>
                </a>
                <div class="rail-cta-row">
                    <a href="/new?type=note" class="btn small" title="New note">
                        @templ.Raw(IconNote)
                        <span>Note</span>
                    </a>
                    <a href="/new?type=link" class="btn small" title="New link">
                        @templ.Raw(IconLink)
                        <span>Link</span>
                    </a>
                </div>
            </div>
        }
        <div class="rail-section">
            for _, v := range NavViews {
                <a class="rail-link"
                   href={ templ.SafeURL(BuildViewURL(v.Slug)) }
                   if d.View == v.Slug {
                       aria-current="true"
                   }>
                    @templ.Raw(v.Icon)
                    <span>{ v.Label }</span>
                    <span class="count">{ countFmt(CountFor(d.Counts, v.Slug)) }</span>
                </a>
            }
            if len(d.TagCounts) > 0 {
                <h3>Tags</h3>
                for _, tc := range d.TagCounts {
                    <a class="rail-link"
                       href={ templ.SafeURL("/tag/" + tc.Tag) }
                       if d.Tag == tc.Tag {
                           aria-current="true"
                       }>
                        @templ.Raw(IconHash)
                        <span>{ tc.Tag }</span>
                        <span class="count">{ countFmt(tc.Count) }</span>
                    </a>
                }
            }
        </div>
    </nav>
}

func countFmt(n int) string {
    if n == 0 {
        return ""
    }
    return itoa(n)
}

func itoa(n int) string {
    if n == 0 { return "0" }
    neg := n < 0
    if neg { n = -n }
    var b [20]byte
    i := len(b)
    for n > 0 {
        i--
        b[i] = byte('0' + n%10)
        n /= 10
    }
    if neg { i--; b[i] = '-' }
    return string(b[i:])
}
